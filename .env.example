# --- Provider selection ---
# "openai" (default, as specified by the assignment) or "gemini" (free tier, for testing).
LLM_PROVIDER=openai

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key

# --- Google Gemini (used when LLM_PROVIDER=gemini) — free tier, no card ---
GOOGLE_API_KEY=your_google_api_key

# --- Pinecone (always required) ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=agentic-ai-index

# Optional: Pinecone serverless location (defaults shown)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
