@'
# Provider selection
LLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-index-gemini

# Pinecone serverless location
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
'@ | Set-Content -Encoding utf8 .env.example